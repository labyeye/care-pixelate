{
  "name": "nestcare-backend",
  "version": "0.1.0",
  "description": "NestCare — Multi-tenant Healthcare SaaS Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/audit-models.js && node scripts/test-pharmacy.js && node scripts/smoke-http.js",
    "test:offline": "node scripts/audit-models.js && for f in scripts/check-*.js; do node $f || exit 1; done",
    "migrate:pharmacy": "node scripts/migrate-pharmacy.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  }
